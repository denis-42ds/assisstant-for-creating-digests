# Переключение LLM-бэкенда (pipeline/llm_stage.py). Переменная окружения,
# не ветка кода - требование организаторов. Варианты: claude | ollama |
# gemini | openrouter. Для проверки организаторами обязателен ollama
# (Q&A 30.09) - остальное для разработки, если нет-доступа к одному из них.
LLM_BACKEND=claude

# --- LLM_BACKEND=claude ---
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-haiku-4-5-20251001

# --- LLM_BACKEND=ollama (обязателен для финальной проверки) ---
# ollama pull qwen3.6:35b-a3b
# ollama serve  (рекомендуется: export OLLAMA_CONTEXT_LENGTH=22000)
OLLAMA_MODEL=qwen3.6:35b-a3b
OLLAMA_BASE_URL=http://localhost:11434

# --- LLM_BACKEND=gemini ---
# Ключ: https://aistudio.google.com/apikey
# Модель не подставлена по умолчанию - каталог Gemini меняется, проверь
# актуальный список: https://ai.google.dev/gemini-api/docs/models
GEMINI_API_KEY=
GEMINI_MODEL=

# --- LLM_BACKEND=openrouter ---
# Ключ: https://openrouter.ai/keys
# Модель не подставлена по умолчанию - выбери из https://openrouter.ai/models
OPENROUTER_API_KEY=
OPENROUTER_MODEL=
