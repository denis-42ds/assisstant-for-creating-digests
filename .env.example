# Переключение LLM-бэкенда (pipeline/llm_stage.py): переменная окружения.
# Варианты: claude | ollama | gemini | openrouter.

LLM_BACKEND=gemini

# --- LLM_BACKEND=claude ---
ANTHROPIC_API_KEY=your-secret-api-key
CLAUDE_MODEL=claude-haiku-4-5-20251001

# --- LLM_BACKEND=ollama ---
# ollama pull qwen3.6:35b-a3b
# ollama serve  (рекомендуется: export OLLAMA_CONTEXT_LENGTH=22000)
OLLAMA_MODEL=qwen3.6:35b-a3b
OLLAMA_BASE_URL=http://localhost:11434

# --- LLM_BACKEND=gemini ---
GEMINI_API_KEY=your-secret-api-key
GEMINI_MODEL=gemini-3.5-flash-lite

# --- LLM_BACKEND=openrouter ---
OPENROUTER_API_KEY=your-secret-api-key
OPENROUTER_MODEL=inclusionai/ling-3.1-flash
